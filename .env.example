# MongoDB: локально mongodb://localhost:27017/<db>, на Vercel — строка подключения Atlas
MONGO_URI=mongodb://localhost:27017/blogger-platform

# SMTP для писем подтверждения регистрации и восстановления пароля.
# ОБЯЗАТЕЛЕН на деплое: без него письма не отправляются (используется jsonTransport),
# и автотесты инкубатора не получают код из ящика.
#
# Формат: smtps://<user>:<password>@<host>   (smtps -> порт 465, smtp -> 587)
# Спецсимволы в user/password надо percent-encode'ить, в т.ч. '@' -> %40:
#   gmail:  smtps://myname%40gmail.com:<app-password>@smtp.gmail.com
#   yandex: smtps://myname%40yandex.ru:<app-password>@smtp.yandex.ru
# Обычный пароль от почты не подойдёт — нужен пароль приложения.
SMTP_URL=

# Необязательно. По умолчанию берётся адрес из SMTP_URL — провайдеры отвергают
# письмо, если From не совпадает с аккаунтом авторизации.
SMTP_FROM=

# Секрет для подписи access-токена (по умолчанию 'access-token-secret')
JWT_SECRET=

# Секрет для подписи refresh-токена (по умолчанию 'refresh-token-secret').
# Должен отличаться от JWT_SECRET: иначе access-токен пройдёт как refresh
JWT_REFRESH_SECRET=

# Сроки жизни токенов. Дефолты (10s/20s) заданы под автотесты инкубатора:
# они проверяют, что access протухает после паузы в 10 сек, а refresh — после 20.
# Для ручной работы можно поднять, напр. ACCESS_TOKEN_TTL=10m
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=
